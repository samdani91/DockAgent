        <mxCell id="3" value="Flaky Dockerfile&#xa;unpredictable build failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;fontColor=#2C2C2A;strokeColor=#888780;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="215" y="58" width="250" height="52" as="geometry" />
        </mxCell>
        <!-- STEP 1 -->
        <mxCell id="4" value="Step 1 · Dockerfile building&#xa;Build n times; capture build output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B4EAF;fontColor=#ffffff;strokeColor=#4A3483;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="160" width="320" height="62" as="geometry" />
        </mxCell>
        <!-- STEP 2 -->
