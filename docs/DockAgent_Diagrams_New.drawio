          <mxGeometry x="160" y="278" width="360" height="62" as="geometry" />
        </mxCell>
        <!-- STEP 3 -->
        <mxCell id="6" value="Step 3 · Repair generation (LLM / GPT-4)&#xa;Prompt: task desc + Dockerfile + build output&#xa;+ top-3 similar examples + CoT + false repair history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B4EAF;fontColor=#ffffff;strokeColor=#4A3483;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="396" width="360" height="78" as="geometry" />
        </mxCell>
        <!-- STEP 4 -->
        <mxCell id="7" value="Step 4 · Repair validation&#xa;Build repaired Dockerfile n times; check all builds pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B4EAF;fontColor=#ffffff;strokeColor=#4A3483;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="532" width="360" height="62" as="geometry" />
        </mxCell>
        <!-- DECISION 1: All pass? -->
