        <!-- YES → Repaired Dockerfile -->
        <mxCell id="9" value="Repaired Dockerfile&#xa;stable build output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D9E75;fontColor=#ffffff;strokeColor=#0F6E56;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="462" y="652" width="180" height="58" as="geometry" />
        </mxCell>
        <!-- DECISION 2: Same error >= T? -->
        <mxCell id="10" value="Same error&#xa;≥ T = 3?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontSize=12;" vertex="1" parent="1">
