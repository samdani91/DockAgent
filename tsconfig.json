{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "types": ["node"],
    "moduleResolution": "nodenext",
    "outDir": "./out",
    "rootDir": "./src",
    "declaration": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out"
  ]
}
